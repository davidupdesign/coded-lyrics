{
  "name": "coded-lyrics",
  "version": "1.0.0",
  "description": "Play audio with word-by-word Brat-style lyrics in the terminal",
  "type": "module",
  "bin": {
    "coded-lyrics": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lyrics",
    "terminal",
    "cli",
    "audio",
    "brat"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "commander": "^13.1.0"
  }
}
