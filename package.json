{
  "name": "coded-lyrics",
  "version": "1.0.0",
  "description": "Play audio with word-by-word Brat-style lyrics in the terminal",
  "type": "module",
  "bin": {
    "coded-lyrics": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run goldens:check",
    "typecheck": "tsc --noEmit && npm run check:core && npm --prefix web run typecheck",
    "check:core": "node scripts/check-core.mjs",
    "goldens": "tsx src/dev/dump-frame.ts test/fixtures/golden-frames.txt",
    "goldens:check": "node scripts/check-goldens.mjs",
    "web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lyrics",
    "terminal",
    "cli",
    "audio",
    "brat"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "commander": "^13.1.0"
  }
}
